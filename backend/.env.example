FRONTEND_ORIGIN=http://localhost:3000
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=2048
MAX_IMAGE_COUNT=500
MAX_AUDIO_TRACKS=20
PROJECT_TTL_HOURS=24
STORAGE_RESERVE_PERCENT=10
SCRATCH_RESERVE_MIN_MB=64
SCRATCH_RESERVE_MAX_MB=128

# Необязательно. Для облачного режима нужны одновременно true и серверный ключ.
# Без ключа остаётся локальная синхронизация по паузам FFmpeg.
OPENAI_TRANSCRIPTION_ENABLED=false
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIPTION_LANGUAGE=ru
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=600
OPENAI_TRANSCRIPTION_MAX_MINUTES_PER_HOUR=120
AUDIO_MINIMUM_SCENE_MS=700
AUDIO_TRACK_GAP_MS=750
AUDIO_SILENCE_NOISE_DB=-35
AUDIO_MINIMUM_SILENCE_MS=280
AUDIO_ANALYSIS_CONCURRENCY=2
RENDER_CONCURRENCY=1
FFMPEG_RENDER_THREADS=1
# STORAGE_ROOT=/data
# SCRATCH_ROOT=/tmp/autoframes/work
# OUTPUT_ROOT=/tmp/autoframes/output
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FFPROBE_BINARY=/usr/bin/ffprobe
